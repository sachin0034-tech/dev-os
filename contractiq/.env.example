# =============================================================================
# ContractIQ — environment variables (template — keep values EMPTY in this file)
# Copy to .env.local for local development and fill in every value.
# In Vercel: Project → Settings → Environment Variables (Production + Preview).
# Spec: docs/specs/project-setup-and-conventions.md §6
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=                # Public base URL, no trailing slash. Local: http://localhost:3000 · Prod: your Vercel/custom domain. Used for auth email redirects (/auth/callback)
NEXT_PUBLIC_SUPPORT_EMAIL=          # Inbox shown on the quota-exceeded "Join the waitlist" CTA, e.g. support@yourdomain.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=           # Supabase project URL — Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # Supabase anon/public key — Dashboard → Project Settings → API → anon public
SUPABASE_SERVICE_ROLE_KEY=          # SERVER ONLY — Supabase service_role key (bypasses RLS) — Dashboard → Project Settings → API → service_role. Never expose to the browser
SUPABASE_PROJECT_ID=                # Project ref used by `npm run db:types` — Dashboard → Project Settings → General → Reference ID

# Azure AI Foundry agent (replaces OpenAI — see skills/azure-ai-foundry/SKILL.md)
AZURE_API_KEY=                      # SERVER ONLY — Foundry portal → your project → Settings → API keys
AZURE_AGENT_ENDPOINT=               # SERVER ONLY — Foundry project endpoint (…services.ai.azure.com/api/projects/<project>) or the agent's …/responses URL. Never an openai.azure.com URL
AZURE_AGENT_NAME=                   # SERVER ONLY — Agent name from Foundry → Agents (e.g. Demoagent)
AI_PRICE_INPUT_PER_1M=              # SERVER ONLY — USD per 1M input tokens for cost logging (default 0.40, gpt-4.1-mini)
AI_PRICE_OUTPUT_PER_1M=             # SERVER ONLY — USD per 1M output tokens for cost logging (default 1.60)

# Cost monitoring
COST_ALERT_DAILY_USD=               # SERVER ONLY — Daily OpenAI spend (USD) above which the retention cron logs a cost alert, e.g. 15

# Vercel Cron
CRON_SECRET=                        # SERVER ONLY — Random 32+ char secret; Vercel sends it as "Authorization: Bearer <CRON_SECRET>". Generate: openssl rand -hex 32

# Limits
MAX_CHAT_HISTORY=100                # SERVER ONLY — Hard cap on chat messages loaded/sent to the model (memory layer uses 10/20 turns within this cap)

# Testing (local / CI only — never set in Production)
AI_MOCK_MODE=                       # SERVER ONLY — "true" makes lib/ai return fixture responses (Playwright E2E). Leave empty in Production
